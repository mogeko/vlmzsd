# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = false

# Zig: 4-space indent, no tabs; `zig fmt` emits a trailing newline and enforces a 100-column limit.
[*.zig]
indent_style = space
indent_size = 4
insert_final_newline = true
max_line_length = 100

# JSON: 2-space indent is the de-facto community standard.
[*.json]
indent_style = space
indent_size = 2
insert_final_newline = true

# ZON (Zig Object Notation): follow Zig's 4-space style.
[*.zon]
indent_style = space
indent_size = 4
insert_final_newline = true

# YAML: 2-space indent.
[*.{yml,yaml}]
indent_style = space
indent_size = 2
insert_final_newline = true
